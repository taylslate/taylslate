# Inbox that receives platform email for managed (concierge) brand accounts.
# The original recipient is noted in the subject as [managed: brand@x.com].
# When this is unset, those sends are skipped and logged.
# Set the same value in Vercel (Production) to the inbox Chris reads.
# Login and magic-link mail is not rerouted.
MANAGED_ACCOUNT_INBOX=

# Automated airchecks. Unset skips the cron. Do not commit a real key.
OPENAI_API_KEY=
# USD cap for one aircheck cron run. Unset uses 1 (about 166 Whisper minutes).
AIRCHECK_RUN_COST_CAP_USD=
